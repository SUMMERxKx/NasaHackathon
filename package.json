{
  "name": "ember",
  "version": "1.0.0",
  "private": true,
  "description": "EMBER: a fire evidence map for crew habitats, built with NASA open data from the PSI repository",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node scripts/copy-ort.mjs && vite",
    "build": "node scripts/copy-ort.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "fetch": "node scripts/fetch-psi.mjs",
    "build:data": "node scripts/build-data.mjs",
    "build:pinned": "node scripts/build-pinned-answers.mjs",
    "data:report": "node scripts/data-report.mjs",
    "eval:ask": "node scripts/eval-ask.mjs",
    "check:data": "node scripts/check-data.mjs",
    "check:style": "node scripts/check-style.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "ci": "npm test && npm run check:data && npm run check:style && npm run check:tokens && npm run build && npm run check:secrets",
    "build:embeddings": "node scripts/build-embeddings.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@huggingface/transformers": "^4.3.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-array": "^3.2.5",
    "d3-dsv": "^3.0.2",
    "d3-interpolate": "^3.0.2",
    "d3-scale": "^4.0.3",
    "d3-shape": "^3.2.1",
    "framer-motion": "^14.14.0",
    "lucide-react": "^1.73.0",
    "minisearch": "^7.2.0",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/d3-array": "^3.2.2",
    "@types/d3-dsv": "^3.0.7",
    "@types/d3-interpolate": "^3.0.4",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
